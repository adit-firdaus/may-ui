{
  "projectId": "395ba6af-772e-4469-b2d6-7af4a0f3ebe6",
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "pkg": "mayui",
  "globalName": "MayUI",
  "entry": "dist/mayui.js",
  "cssEntry": "dist/mayui.css",
  "buildCmd": "npm run build",
  "storybookStatic": ".design-sync/sb-reference",
  "titleMap": {
    "Overview": null
  },
  "readmeHeader": ".design-sync/conventions.md",
  "extraEntries": [
    "./dist/desktop.js",
    "./dist/mobile.js"
  ],
  "overrides": {
    "AlertDialog": {
      "cardMode": "column"
    },
    "Fab": {
      "cardMode": "column"
    },
    "Popover": {
      "cardMode": "column"
    },
    "Stepper": {
      "cardMode": "column"
    },
    "Toolbar": {
      "cardMode": "column"
    },
    "Tooltip": {
      "cardMode": "column"
    },
    "NavBar": {
      "cardMode": "column"
    },
    "CommandPalette": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "FloatingBubble": {
      "cardMode": "single",
      "primaryStory": "AssistiveTouch"
    },
    "TabBar": {
      "cardMode": "single",
      "primaryStory": "Default"
    }
  }
}
