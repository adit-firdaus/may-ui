{
  "projectId": "83bc26d8-ff7e-4668-a036-2ad377aa6dd3",
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "pkg": "mayui",
  "globalName": "MayUI",
  "entry": "dist/mayui.js",
  "buildCmd": "npm run build",
  "storybookStatic": ".design-sync/sb-reference",
  "titleMap": {
    "Overview": null
  },
  "readmeHeader": ".design-sync/conventions.md",
  "provider": {
    "component": "MayProvider",
    "props": {
      "inline": true,
      "theme": { "mode": "light" }
    }
  },
  "extraEntries": [
    "./dist/desktop.js",
    "./dist/mobile.js",
    "./dist/examples.js"
  ],
  "overrides": {
    "AlertDialog": {
      "cardMode": "column"
    },
    "Fab": {
      "cardMode": "column"
    },
    "Popover": {
      "cardMode": "column"
    },
    "Stepper": {
      "cardMode": "column"
    },
    "Toolbar": {
      "cardMode": "column"
    },
    "Tooltip": {
      "cardMode": "column"
    },
    "NavBar": {
      "cardMode": "column"
    },
    "CommandPalette": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "FloatingBubble": {
      "cardMode": "single",
      "primaryStory": "AssistiveTouch"
    },
    "TabBar": {
      "cardMode": "single",
      "primaryStory": "Default"
    },
    "Badge": {
      "cardMode": "column"
    },
    "Pagination": {
      "cardMode": "column"
    },
    "DataTable": {
      "cardMode": "column"
    },
    "Slider": {
      "cardMode": "column"
    }
  }
}
