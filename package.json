{
  "name": "@adit_firdaus/may-ui",
  "version": "0.2.0",
  "description": "May UI \u2014 an Apple-native React design system with iOS design language and real spring motion.",
  "type": "module",
  "license": "MIT",
  "author": "Adit Firdaus <aditfirdaus.dml@gmail.com>",
  "homepage": "https://github.com/adit-firdaus/may-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adit-firdaus/may-ui.git"
  },
  "bugs": {
    "url": "https://github.com/adit-firdaus/may-ui/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "ios",
    "apple",
    "tailwind-free"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/mayui.cjs",
  "module": "./dist/mayui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mayui.js",
      "require": "./dist/mayui.cjs"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js",
      "require": "./dist/desktop.cjs"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js",
      "require": "./dist/mobile.cjs"
    },
    "./package.json": "./package.json",
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js",
      "require": "./dist/examples.cjs"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run verify",
    "prepare": "npm run build",
    "gen:springs": "node scripts/gen-springs.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "generate": "npm run gen:springs && npm run gen:tokens",
    "build": "npm run generate && tsc --noEmit -p tsconfig.check.json && vite build",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "smoke": "node scripts/smoke.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:size": "node scripts/check-size.mjs",
    "verify": "npm run build && npm run check:generated && npm run smoke && npm run check:provider && npm run check:tokens && npm run check:contract && npm run check:size && npm run check:consumer-size && npm run check:coverage && npm run check:docs && npm run site:build && npm run check:site",
    "check:provider": "node scripts/check-provider.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "site:meta": "node scripts/gen-catalog-meta.mjs",
    "site:typecheck": "tsc --noEmit -p examples/tsconfig.json",
    "site": "npm run site:meta && vite --config examples/vite.config.ts",
    "site:build": "npm run site:meta && npm run site:typecheck && vite build --config examples/vite.config.ts",
    "site:preview": "vite preview --config examples/vite.config.ts --base /may-ui/",
    "check:site": "npm run site:meta && node scripts/check-site.mjs",
    "examples": "npm run site",
    "examples:build": "npm run site:build",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:consumer-size": "node scripts/check-consumer-size.mjs"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/react": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "easing-utils": "^1.0.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "motion": "^13.2.0",
    "react-icons": "^5.7.0"
  }
}
