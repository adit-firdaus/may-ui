{
  "name": "may-ui",
  "version": "0.1.0",
  "description": "May UI — an Apple-native React design system: iOS design language, real spring motion, zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Adit Firdaus <aditfirdaus.dml@gmail.com>",
  "homepage": "https://github.com/adit-firdaus/may-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adit-firdaus/may-ui.git"
  },
  "bugs": {
    "url": "https://github.com/adit-firdaus/may-ui/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "components",
    "ui",
    "ios",
    "apple",
    "tailwind-free"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "main": "./dist/mayui.cjs",
  "module": "./dist/mayui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mayui.js",
      "require": "./dist/mayui.cjs"
    },
    "./desktop": {
      "types": "./dist/desktop.d.ts",
      "import": "./dist/desktop.js",
      "require": "./dist/desktop.cjs"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js",
      "require": "./dist/mobile.cjs"
    },
    "./styles.css": "./dist/mayui.css",
    "./package.json": "./package.json",
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js",
      "require": "./dist/examples.cjs"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "gen:springs": "node scripts/gen-springs.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "generate": "npm run gen:tokens && npm run gen:springs",
    "build": "npm run generate && tsc --noEmit -p tsconfig.check.json && vite build",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "smoke": "node scripts/smoke.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:size": "node scripts/check-size.mjs",
    "verify": "npm run build && npm run smoke && npm run check:tokens && npm run check:contract && npm run check:size && npm run check:coverage",
    "check:contract": "node scripts/check-contract.mjs",
    "examples": "vite --config examples/vite.config.ts",
    "examples:build": "vite build --config examples/vite.config.ts",
    "check:coverage": "node scripts/check-coverage.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "easing-utils": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react-icons": "^5.7.0"
  }
}
